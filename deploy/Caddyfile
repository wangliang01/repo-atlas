  email admin@wlv587.top
}

wlv587.top, car.wlv587.top {
  reverse_proxy car_service_nginx:80
}

omni.wlv587.top {
  reverse_proxy omniroute:20128
}

tv.wlv587.top {
  root * /srv/catalog
  file_server
}

blog.wlv587.top {
  root * /srv/blog
  encode zstd gzip
  # 已经发出去的 /projects 链接不能死；Next 的 redirects 在 output: export 下用不了
  redir /projects / 308
  # 精选已经并进首页；只拦精确的 /picks，/picks/<slug> 详情页保留
  redir /picks / 308
  # 导出产物是 notes/foo.html，要能按 /notes/foo 访问
  try_files {path}.html {path} {path}/index.html
  file_server
  header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
  handle_errors {
    rewrite * /404.html
    file_server
  }
}
